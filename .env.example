# ============================================================================
# PW5 EventsCRM — LLM-Agnostic Multi-Agent Configuration
# ============================================================================
# Supported LLM_PROVIDER values:
#   - auto        (Automatically selects first configured API key, or falls back to Autonomous Swarm Engine)
#   - antigravity (Google Antigravity SDK / Gemini)
#   - gemini      (Google Gemini API via REST/SDK)
#   - openai      (OpenAI or OpenAI-compatible endpoint via OPENAI_BASE_URL)
#   - anthropic   (Anthropic Claude API)
LLM_PROVIDER=auto

# Optional explicit model override (leave blank for provider default)
# Examples: gemini-2.5-pro, gpt-4o, claude-3-7-sonnet-latest
LLM_MODEL=

# Provider API Keys (Populate any one or more; leave empty to use built-in Smart Autonomous Engine)
GEMINI_API_KEY=
ANTIGRAVITY_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional custom OpenAI-compatible base URL (e.g., OpenRouter, Together, Ollama, vLLM)
OPENAI_BASE_URL=https://api.openai.com/v1

# Database & Server Configuration
DATABASE_URL=sqlite:///./events_crm.db
BACKEND_PORT=8000
FRONTEND_PORT=5173
